{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/agnostify/context-pill/main/schema/breaking.schema.json",
  "title": "Context Pill Breaking AI News (engagement-ranked, not verified)",
  "type": "object",
  "required": ["date", "updated_at", "updated_pt", "label", "warning", "min_score", "max_stories", "platforms_missing", "stories"],
  "properties": {
    "schema": {"type": "string"},
    "date": {"type": "string", "format": "date"},
    "updated_at": {"type": "string"},
    "updated_pt": {"type": "string"},
    "refresh_hours": {"type": "integer", "minimum": 1},
    "label": {"type": "string"},
    "warning": {"type": "string"},
    "min_score": {"type": "number"},
    "max_stories": {"type": "integer", "minimum": 0},
    "ranking_basis": {"type": "object"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "platforms_missing": {"type": "array", "items": {"type": "object", "required": ["platform", "reason"],
      "properties": {"platform": {"type": "string"}, "reason": {"type": "string"}}}},
    "stories": {"type": "array", "items": {"$ref": "#/$defs/story"}}
  },
  "$defs": {
    "story": {
      "type": "object",
      "required": ["id", "rank", "title", "primary_url", "primary_kind", "primary_name", "links", "counts", "platforms", "score"],
      "properties": {
        "id": {"type": "string", "pattern": "^b-[0-9a-f]{10}$"},
        "rank": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "maxLength": 300},
        "why_it_matters": {"type": ["string", "null"]},
        "primary_url": {"type": "string", "format": "uri"},
        "primary_kind": {"enum": ["company", "reddit", "x"]},
        "primary_name": {"type": "string"},
        "links": {"type": "array", "items": {"type": "object", "required": ["kind", "url"],
          "properties": {"kind": {"enum": ["company", "outlet", "reddit"]}, "url": {"type": "string", "format": "uri"}}}},
        "counts": {
          "type": "object",
          "properties": {
            "x": {"type": "object", "required": ["likes", "reposts", "replies", "views", "posts"],
              "properties": {"likes": {"type": "integer", "minimum": 0}, "reposts": {"type": "integer", "minimum": 0},
                "replies": {"type": "integer", "minimum": 0}, "views": {"type": "integer", "minimum": 0}, "posts": {"type": "integer", "minimum": 1}}},
            "reddit": {"type": "object", "required": ["upvotes", "comments", "posts", "subreddits", "upvotes_understated"],
              "properties": {"upvotes": {"type": "integer"}, "comments": {"type": "integer", "minimum": 0}, "posts": {"type": "integer", "minimum": 1},
                "subreddits": {"type": "array", "items": {"type": "string"}}, "upvotes_understated": {"type": "boolean"}}},
            "company": {"type": "object", "required": ["names"], "properties": {"names": {"type": "array", "items": {"type": "string"}}}},
            "outlet": {"type": "object", "required": ["names"], "properties": {"names": {"type": "array", "items": {"type": "string"}}}}
          }
        },
        "platforms": {"type": "array", "items": {"enum": ["x", "reddit", "company"]}},
        "score": {"type": "number", "minimum": 0},
        "first_seen": {"type": "string"}
      }
    }
  }
}
